{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C64: Build",
      "type": "process",
      "command": "${config:c64.acmePath}",
      "args": [
        "--cpu",
        "6510",
        "-f",
        "cbm",
        "-o",
        "build/main.prg",
        "-r",
        "build/main.report",
        "--vicelabels",
        "build/main.vs",
        "src/main.asm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "C64: Build and Run",
      "type": "process",
      "command": "${config:c64.vicePath}",
      "dependsOn": "C64: Build",
      "args": [
        "-autostartprgmode",
        "1",
        "-autostart",
        "${workspaceFolder}/build/main.prg"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
