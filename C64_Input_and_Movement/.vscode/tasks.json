{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build 00_kernal_text",
      "type": "process",
      "command": "acme",
      "windows": {
        "command": "acme.exe"
      },
      "args": [
        "-f",
        "cbm",
        "-o",
        "${workspaceFolder}/build/00_kernal_text.prg",
        "--symbollist",
        "${workspaceFolder}/build/00_kernal_text.sym",
        "${workspaceFolder}/source/00_kernal_text.asm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build and run 00_kernal_text",
      "type": "process",
      "command": "x64sc",
      "windows": {
        "command": "x64sc.exe"
      },
      "args": [
        "-autostart",
        "${workspaceFolder}/build/00_kernal_text.prg"
      ],
      "dependsOn": [
        "Build 00_kernal_text"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
