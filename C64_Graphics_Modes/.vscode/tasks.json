{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C64 Build active assembly file",
      "type": "process",
      "command": "acme",
      "windows": {
        "command": "acme.exe"
      },
      "args": [
        "-f",
        "cbm",
        "-o",
        "${workspaceFolder}/prg/${fileBasenameNoExtension}.prg",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "C64 Build and run active assembly file",
      "type": "process",
      "command": "x64sc",
      "windows": {
        "command": "x64sc.exe"
      },
      "args": [
        "-autostartprgmode",
        "1",
        "-autostart",
        "${workspaceFolder}/prg/${fileBasenameNoExtension}.prg"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "dependsOn": "C64 Build active assembly file",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
